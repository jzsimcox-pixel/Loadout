{
  "version": 2,
  "profile": "ayn-odin2-portal",
  "profileName": "AYN Odin 2 Portal",
  "placeholders": {
    "INTERNAL": "internal storage",
    "PKG": "the emulator's Android package name",
    "BIOS_DIR": "the BIOS folder Loadout found or created",
    "RETROARCH_DIR": "RetroArch's folder on internal storage or the card",
    "RETROARCH_DATA": "RetroArch's own app data folder",
    "PS2_BIOS_FILE": "file name of the PS2 BIOS Loadout found"
  },
  "emulators": {
    "RetroArch": {
      "files": [
        {
          "template": "retroarch/retroarch.cfg.patch",
          "root": "{{INTERNAL}}/Android/data/{{PKG}}/files",
          "path": "retroarch.cfg",
          "mode": "merge-cfg"
        },
        {
          "template": "retroarch/config/Nestopia/Nestopia.opt",
          "root": "{{INTERNAL}}/RetroArch",
          "path": "config/Nestopia/Nestopia.opt",
          "mode": "merge-cfg"
        },
        {
          "template": "retroarch/config/Snes9x/Snes9x.opt",
          "root": "{{INTERNAL}}/RetroArch",
          "path": "config/Snes9x/Snes9x.opt",
          "mode": "merge-cfg"
        },
        {
          "template": "retroarch/config/Genesis Plus GX/Genesis Plus GX.opt",
          "root": "{{INTERNAL}}/RetroArch",
          "path": "config/Genesis Plus GX/Genesis Plus GX.opt",
          "mode": "merge-cfg"
        },
        {
          "template": "retroarch/config/Gambatte/Gambatte.opt",
          "root": "{{INTERNAL}}/RetroArch",
          "path": "config/Gambatte/Gambatte.opt",
          "mode": "merge-cfg"
        },
        {
          "template": "retroarch/config/mGBA/mGBA.opt",
          "root": "{{INTERNAL}}/RetroArch",
          "path": "config/mGBA/mGBA.opt",
          "mode": "merge-cfg"
        },
        {
          "template": "retroarch/config/SwanStation/SwanStation.opt",
          "root": "{{INTERNAL}}/RetroArch",
          "path": "config/SwanStation/SwanStation.opt",
          "mode": "merge-cfg"
        },
        {
          "template": "retroarch/shaders/crt-trinitron.slangp",
          "root": "{{INTERNAL}}/RetroArch",
          "path": "config/global.slangp",
          "mode": "replace",
          "optional": "shader"
        }
      ],
      "resolution": [
        {
          "file": "retroarch/config/SwanStation/SwanStation.opt",
          "key": "swanstation_GPU_ResolutionScale"
        }
      ]
    },
    "Dolphin": {
      "files": [
        {
          "template": "dolphin/Dolphin.ini",
          "root": "{{INTERNAL}}/Android/data/{{PKG}}/files",
          "path": "Config/Dolphin.ini",
          "mode": "merge-ini"
        },
        {
          "template": "dolphin/GFX.ini",
          "root": "{{INTERNAL}}/Android/data/{{PKG}}/files",
          "path": "Config/GFX.ini",
          "mode": "merge-ini"
        },
        {
          "template": "dolphin/GCPadNew.ini",
          "root": "{{INTERNAL}}/Android/data/{{PKG}}/files",
          "path": "Config/GCPadNew.ini",
          "mode": "merge-ini"
        },
        {
          "template": "dolphin/WiimoteNew.ini",
          "root": "{{INTERNAL}}/Android/data/{{PKG}}/files",
          "path": "Config/WiimoteNew.ini",
          "mode": "merge-ini"
        }
      ],
      "resolution": [
        {
          "file": "dolphin/GFX.ini",
          "key": "Settings/InternalResolution"
        }
      ]
    },
    "Eden": {
      "files": [
        {
          "template": "eden/config.ini.patch",
          "root": "{{INTERNAL}}/Android/data/{{PKG}}/files",
          "path": "config/config.ini",
          "mode": "merge-ini"
        }
      ]
    },
    "ARMSX2": {
      "files": [
        {
          "template": "armsx2/armsx2-settings.json",
          "root": "{{INTERNAL}}/Armsx2",
          "path": "armsx2-settings.json",
          "mode": "merge-json"
        },
        {
          "template": "armsx2/PCSX2-Android.ini",
          "root": "{{INTERNAL}}/Armsx2",
          "path": "PCSX2-Android.ini",
          "mode": "merge-ini"
        }
      ],
      "resolution": [
        {
          "file": "armsx2/armsx2-settings.json",
          "key": "global/upscaleFloat"
        },
        {
          "file": "armsx2/PCSX2-Android.ini",
          "key": "EmuCore/GS/upscale_multiplier"
        }
      ]
    }
  }
}
